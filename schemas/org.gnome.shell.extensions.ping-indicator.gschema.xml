<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ping-indicator" path="/org/gnome/shell/extensions/ping-indicator/">
    <!-- Configuración existente -->
    <key name="refresh-interval" type="i">
      <default>5</default>
      <summary>Refresh interval (seconds) when everything looks stable</summary>
    </key>
    <key name="refresh-interval-unstable" type="i">
      <default>2</default>
      <summary>Refresh interval (seconds) while unstable/bad is detected — never slower than refresh-interval</summary>
    </key>
    <key name="gateway-address" type="s">
      <default>""</default>
      <summary>Gateway IP</summary>
    </key>
    <key name="internet-address" type="s">
      <default>"8.8.8.8"</default>
      <summary>Internet server</summary>
    </key>
    
    <!-- Nuevos umbrales para iconos -->
    <key name="local-good-threshold" type="i">
      <default>50</default>
      <summary>Local good ping threshold</summary>
    </key>
    <key name="local-medium-threshold" type="i">
      <default>100</default>
      <summary>Local medium ping threshold</summary>
    </key>
    <key name="internet-good-threshold" type="i">
      <default>100</default>
      <summary>Internet good ping threshold</summary>
    </key>
    <key name="internet-medium-threshold" type="i">
      <default>500</default>
      <summary>Internet medium ping threshold</summary>
    </key>

    <!-- Ráfaga de pings (jitter / pérdida) -->
    <key name="ping-count" type="i">
      <default>5</default>
      <summary>Pings per burst</summary>
    </key>
    <key name="local-loss-threshold" type="i">
      <default>20</default>
      <summary>Local packet loss %% to mark unstable</summary>
    </key>
    <key name="local-jitter-threshold" type="i">
      <default>25</default>
      <summary>Local jitter (mdev, ms) to mark unstable</summary>
    </key>
    <key name="internet-loss-threshold" type="i">
      <default>20</default>
      <summary>Internet packet loss %% to mark unstable</summary>
    </key>
    <key name="internet-jitter-threshold" type="i">
      <default>30</default>
      <summary>Internet jitter (mdev, ms) to mark unstable</summary>
    </key>

    <!-- Diagnóstico automático mtr -->
    <key name="mtr-enabled" type="b">
      <default>true</default>
      <summary>Run automatic mtr diagnostic when unstable</summary>
    </key>
    <key name="mtr-cooldown" type="i">
      <default>120</default>
      <summary>Seconds between automatic mtr runs</summary>
    </key>

    <!-- Presentación -->
    <key name="show-numeric-labels" type="b">
      <default>true</default>
      <summary>Show the latency value in ms next to each icon</summary>
    </key>
  </schema>
</schemalist>